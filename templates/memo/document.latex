  \newcommand{\reddel}[1]{{\color{red}\sout{##1}}}%
}{%
  \newcommand{\redins}[1]{{\color{blue}##1}}%
  \newcommand{\reddel}[1]{{\color{red}[##1]}}%
}
\newcommand{\redinsplain}[1]{{\color{blue}#1}}
\newcommand{\reddelplain}[1]{{\color{red}#1}}

